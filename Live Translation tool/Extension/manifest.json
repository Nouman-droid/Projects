{
    "manifest_version": 3,
    "name": "Live Translator",
    "version": "1.0",

    "permissions": ["activeTab", "scripting"],

    "host_permissions": [
        "<all_urls>"
    ],

    "action": {
        "default_popup": "popup.html"
    },

    "content_scripts": [
        {
            "js": ["content.js"],
            "matches": ["<all_urls>"],
            "css": ["style.css"]
        }
    ]
}
